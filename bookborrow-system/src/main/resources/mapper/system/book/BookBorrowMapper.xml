<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.book.borrow.lend.mapper.BookBorrowMapper">

    <resultMap type="BookBorrow" id="BookBorrowResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="bookId"    column="book_id"    />
        <result property="bookName"    column="book_name"    />
        <result property="categoryId"    column="category_id"    />
        <result property="categoryName"    column="category_name"    />
        <result property="borrowTime"    column="borrow_time"    />
        <result property="dueTime"    column="due_time"    />
        <result property="returnTime"    column="return_time"    />
        <result property="status"    column="status"    />
        <result property="lateFee"    column="late_fee"    />
        <result property="remark"    column="remark"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="deleted"    column="deleted"    />
        <result property="imgCover"    column="img_cover"    />
    </resultMap>

    <sql id="selectBookBorrowVo">
        select id, user_id, user_name, book_id, book_name, category_id, category_name, borrow_time, due_time, return_time, status, late_fee, remark, create_time, update_time, deleted, img_cover from book_borrow
    </sql>

    <select id="selectBookBorrowList" parameterType="BookBorrow" resultMap="BookBorrowResult">
        <include refid="selectBookBorrowVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="bookId != null "> and book_id = #{bookId}</if>
            <if test="bookName != null  and bookName != ''"> and book_name like concat('%', #{bookName}, '%')</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="categoryName != null "> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="borrowTime != null "> and borrow_time = #{borrowTime}</if>
            <if test="dueTime != null "> and due_time = #{dueTime}</if>
            <if test="returnTime != null "> and return_time = #{returnTime}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="lateFee != null "> and late_fee = #{lateFee}</if>
            <if test="deleted != null "> and deleted = #{deleted}</if>
            <if test="imgCover != null  and imgCover != ''"> and img_cover = #{imgCover}</if>
        </where>
    </select>

    <select id="selectBookBorrowById" parameterType="Long" resultMap="BookBorrowResult">
        <include refid="selectBookBorrowVo"/>
        where id = #{id}
    </select>

    <insert id="insertBookBorrow" parameterType="BookBorrow" useGeneratedKeys="true" keyProperty="id">
        insert into book_borrow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="bookId != null">book_id,</if>
            <if test="bookName != null">book_name,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="categoryName != null">category_name,</if>
            <if test="borrowTime != null">borrow_time,</if>
            <if test="dueTime != null">due_time,</if>
            <if test="returnTime != null">return_time,</if>
            <if test="status != null">status,</if>
            <if test="lateFee != null">late_fee,</if>
            <if test="remark != null">remark,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="deleted != null">deleted,</if>
            <if test="imgCover != null">img_cover,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="bookId != null">#{bookId},</if>
            <if test="bookName != null">#{bookName},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="categoryName != null">#{categoryName},</if>
            <if test="borrowTime != null">#{borrowTime},</if>
            <if test="dueTime != null">#{dueTime},</if>
            <if test="returnTime != null">#{returnTime},</if>
            <if test="status != null">#{status},</if>
            <if test="lateFee != null">#{lateFee},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="deleted != null">#{deleted},</if>
            <if test="imgCover != null">#{imgCover},</if>
        </trim>
    </insert>

    <update id="updateBookBorrow" parameterType="BookBorrow">
        update book_borrow
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="bookId != null">book_id = #{bookId},</if>
            <if test="bookName != null">book_name = #{bookName},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="borrowTime != null">borrow_time = #{borrowTime},</if>
            <if test="dueTime != null">due_time = #{dueTime},</if>
            <if test="returnTime != null">return_time = #{returnTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lateFee != null">late_fee = #{lateFee},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            <if test="imgCover != null">img_cover = #{imgCover},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBookBorrowById" parameterType="Long">
        delete from book_borrow where id = #{id}
    </delete>

    <delete id="deleteBookBorrowByIds" parameterType="String">
        delete from book_borrow where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>