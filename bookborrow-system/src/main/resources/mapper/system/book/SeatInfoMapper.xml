    <select id="selectSeatInfoList" parameterType="SeatInfo" resultMap="SeatInfoInnerResult">
        SELECT
        si.id,
        si.reading_room_id,
        rr.room_name,
        si.row_num,
        si.col_num,
        si.is_available,
        si.is_reserved,
        si.description,
        si.create_time,
        si.update_time,
        si.is_deleted
        FROM seat_info si
        LEFT JOIN reading_room rr ON si.reading_room_id = rr.id
        <trim prefix="WHERE" prefixOverrides="AND |OR ">
            <if test="readingRoomId != null"> reading_room_id = #{readingRoomId} </if>
            <if test="rowNum != null"> AND row_num = #{rowNum} </if>
            <if test="colNum != null"> AND col_num = #{colNum} </if>
            <if test="isAvailable != null"> AND is_available = #{isAvailable} </if>
            <if test="isReserved != null"> AND is_reserved = #{isReserved} </if>
            <if test="description != null and description != ''"> AND description = #{description} </if>
            <if test="isDeleted != null"> AND is_deleted = #{isDeleted} </if>
        </trim>
    </select>

    <select id="selectSeatInfoById" parameterType="Long" resultMap="SeatInfoResult">
        <include refid="selectSeatInfoVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSeatInfo" parameterType="SeatInfo" useGeneratedKeys="true" keyProperty="id">
        insert into seat_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="readingRoomId != null">reading_room_id,</if>
            <if test="rowNum != null">row_num,</if>
            <if test="colNum != null">col_num,</if>
            <if test="isAvailable != null">is_available,</if>
            <if test="isReserved != null">is_reserved,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="readingRoomId != null">#{readingRoomId},</if>
            <if test="rowNum != null">#{rowNum},</if>
            <if test="colNum != null">#{colNum},</if>
            <if test="isAvailable != null">#{isAvailable},</if>
            <if test="isReserved != null">#{isReserved},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateSeatInfo" parameterType="SeatInfo">
        update seat_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="readingRoomId != null">reading_room_id = #{readingRoomId},</if>
            <if test="rowNum != null">row_num = #{rowNum},</if>
            <if test="colNum != null">col_num = #{colNum},</if>
            <if test="isAvailable != null">is_available = #{isAvailable},</if>
            <if test="isReserved != null">is_reserved = #{isReserved},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSeatInfoById" parameterType="Long">
        delete from seat_info where id = #{id}
    </delete>

    <delete id="deleteSeatInfoByIds" parameterType="String">
        delete from seat_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>